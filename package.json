{
  "name": "todo-list",
  "version": "1.0.1",
  "type": "module",
  "description": "A user-friendly and responsive Todo List web application developed using React and Vite",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuanductran/todo-list-vite.git"
  },
  "bugs": {
    "url": "https://github.com/tuanductran/todo-list-vite/issues"
  },
  "author": "Tuan Duc Tran <tuanductran.dev@gmail.com>",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "keywords": [
    "todo",
    "react",
    "vite",
    "millionjs",
    "tailwind"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "biome check --write --unsafe src",
    "preinstall": "npx only-allow pnpm",
    "prettier": "pnpm lint:prettier --write",
    "preview": "vite preview",
    "test:unit": "vitest run --coverage -u",
    "test:e2e": "playwright test",
    "type:check": "tsc"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "@vitejs/plugin-react-oxc": "^0.4.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "clsx": "^2.1.1",
    "cssnano": "^7.1.2",
    "dompurify": "^3.3.1",
    "idb": "^8.0.3",
    "idb-keyval": "^6.2.2",
    "million": "^3.1.11",
    "react": "^19.2.3",
    "react-document-picture-in-picture": "^1.2.2",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "react-hot-toast": "^2.6.0",
    "swr": "^2.3.8",
    "tailwindcss": "^4.1.18",
    "vite-tsconfig-paths": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.50.1",
    "@typescript-eslint/parser": "8.50.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-lightningcss": "^1.0.2",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3",
    "vite": "7.3.0",
    "vitest": "^4.0.16",
    "vitest-localstorage-mock": "^0.1.2",
    "vitest-matchmedia-mock": "^2.0.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@latest"
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@swc/core",
      "@tailwindcss/oxide",
      "@vercel/speed-insights",
      "esbuild"
    ]
  }
}
