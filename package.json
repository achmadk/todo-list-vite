{
  "name": "todo-list",
  "version": "1.0.1",
  "type": "module",
  "description": "A user-friendly and responsive Todo List web application developed using React and Vite",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuanductran/todo-list-vite.git"
  },
  "bugs": {
    "url": "https://github.com/tuanductran/todo-list-vite/issues"
  },
  "author": "Tuan Duc Tran <tuanductran.dev@gmail.com>",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "keywords": [
    "todo",
    "react",
    "vite",
    "millionjs",
    "tailwind"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "biome check --write --unsafe src",
    "preinstall": "npx only-allow pnpm",
    "prettier": "pnpm lint:prettier --write",
    "preview": "vite preview",
    "test:unit": "vitest run --coverage -u",
    "test:e2e": "playwright test",
    "type:check": "tsc"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.1.11",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "@vitejs/plugin-react-oxc": "^0.2.3",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "clsx": "^2.1.1",
    "cssnano": "^7.0.7",
    "dompurify": "^3.2.6",
    "idb": "^8.0.3",
    "idb-keyval": "^6.2.2",
    "million": "^3.1.11",
    "react": "^19.1.0",
    "react-document-picture-in-picture": "^1.2.2",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.58.1",
    "react-hot-toast": "^2.5.2",
    "swr": "^2.3.3",
    "tailwindcss": "^4.1.11",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@playwright/test": "^1.53.1",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "8.35.0",
    "@typescript-eslint/parser": "8.35.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-lightningcss": "^1.0.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vite": "7.0.0",
    "vitest": "^3.2.4",
    "vitest-localstorage-mock": "^0.1.2",
    "vitest-matchmedia-mock": "^2.0.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@latest"
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@swc/core",
      "@tailwindcss/oxide",
      "@vercel/speed-insights",
      "esbuild"
    ]
  }
}
